# Contoh environment untuk docker compose.
# Salin ke file `.env` lalu isi nilai yang sesuai.

# Domain publik (untuk CORS & webhook URL)
CORS_ORIGIN=https://catatin.domain.com
PUBLIC_BASE_URL=https://catatin.domain.com

# Data persisten — bila tidak diisi, default /data di container
# DATA_DIR=/data

# WhatsApp webhook (opsional — kosongkan bila tidak dipakai)
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Timezone
TZ=Asia/Jakarta
